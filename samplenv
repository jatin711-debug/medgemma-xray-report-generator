# Medical Image Analysis API Configuration
# Copy this to .env and modify as needed

# API Configuration
APP_NAME=Medical Image Analysis API
APP_VERSION=1.0.0
DEBUG=false

# Server Configuration  
HOST=127.0.0.1
PORT=8000

# Model Configuration
MODEL_ID=google/medgemma-4b-it
MAX_TOKENS=512
TEMPERATURE=0.7

# File Storage (Windows paths)
REPORTS_DIR=reports
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.tiff,.bmp

# Security (configure for production)
CORS_ORIGINS=*

# Database Configuration (if applicable)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=medgemma_db