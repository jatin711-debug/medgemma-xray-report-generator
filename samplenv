# Copy to .env and replace the key with a generated secret.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ADMIN=
# Optional separate roles; each configured key must be unique and at least 32 characters.
API_KEY_OPERATOR=
API_KEY_READER=
# Each key can instead be read from a mounted file via API_KEY_<ROLE>_FILE.
ENABLE_API_DOCS=false
MODEL_ID=google/medgemma-1.5-4b-it
MEDGEMMA_QUANTIZE=auto
ENABLE_URL_FETCH=false

# Optional URL-to-S3/MySQL reporting integration.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
AWS_REGION=
AWS_S3_BUCKET_NAME=
# AWS credentials may come from the normal boto3 credential chain.
