# Copy to .env and replace the key with a generated secret.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_ADMIN=
# Optional separate roles; each configured key must be unique and at least 32 characters.
API_KEY_OPERATOR=
API_KEY_READER=
# Each key can instead be read from a mounted file via API_KEY_<ROLE>_FILE.
ENABLE_API_DOCS=false
# Outcome thresholds are calibrated per model and precision (see docs/calibration.md);
# other models or precisions report every outcome as indeterminate.
MODEL_ID=google/medgemma-1.5-4b-it
MEDGEMMA_QUANTIZE=auto
# Optional alternative calibration file (defaults to src/core/calibration.json).
MEDGEMMA_CALIBRATION=
# Add a gradient-based attribution map to reports (one extra forward/backward pass).
# Set to 0 to disable, e.g. on low-memory GPUs.
MEDGEMMA_ATTRIBUTION=1
# Optional build identifier shown in reports; defaults to the checked-out git commit.
APP_VERSION=
ENABLE_URL_FETCH=false

# Optional URL-to-S3/MySQL reporting integration.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
AWS_REGION=
AWS_S3_BUCKET_NAME=
# AWS credentials may come from the normal boto3 credential chain.
